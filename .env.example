# Portfolio (florian-tau.vercel.app) — copy to .env for local dev

# Email service: brevo | web3forms | formspree | sendgrid | resend
VITE_EMAIL_SERVICE=brevo

# Brevo REST key for /api/contact (xkeysib-..., from Brevo → SMTP & API → API keys)
BREVO_API_KEY="xkeysib-..."
BREVO_FROM_EMAIL=florthiers@gmail.com
BREVO_TO_EMAIL=florthiers@gmail.com

# Brevo MCP token (eyJ...==) — ONLY for Cursor MCP, not the contact route.
# Values ending in == MUST be quoted or parsers truncate the padding.
BREVO_MCP_TOKEN="eyJ...=="

# Optional fallbacks if VITE_EMAIL_SERVICE is not brevo
VITE_WEB3FORMS_ACCESS_KEY=
VITE_FORMSPREE_FORM_ID=
VITE_SENDGRID_API_KEY=
VITE_RESEND_API_KEY=

# Investment page APIs (optional)
VITE_ALPHA_VANTAGE_API_KEY=
VITE_FRED_API_KEY=
