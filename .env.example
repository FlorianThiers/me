# Portfolio (florian-tau.vercel.app) — copy to .env for local dev

# Email service: resend (default) | brevo | web3forms | formspree | sendgrid
VITE_EMAIL_SERVICE=resend

# Resend — server-only (/api/contact). Same LifeGroup key as E-stock/Vijver when shared.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=florthiers@gmail.com
RESEND_TO_EMAIL=florthiers@gmail.com

# Legacy Brevo (optional until removed from Vercel)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_TO_EMAIL=

# Brevo MCP token — ONLY for Cursor MCP in workflow-os, not the contact route.
BREVO_MCP_TOKEN=

# Optional client-side fallbacks if VITE_EMAIL_SERVICE is not resend/brevo
VITE_WEB3FORMS_ACCESS_KEY=
VITE_FORMSPREE_FORM_ID=
VITE_SENDGRID_API_KEY=

# Investment page APIs (optional)
VITE_ALPHA_VANTAGE_API_KEY=
VITE_FRED_API_KEY=

# Julia Life OS API (Vercel serverless — never prefix with VITE_)
JULIA_API_SECRET=generate-a-long-random-string
NOTION_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional persistent usage dashboard (free tier at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
