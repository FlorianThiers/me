# Portfolio (florian-tau.vercel.app) — copy to .env for local dev

# Email service: brevo (production) | resend | web3forms | formspree | sendgrid
VITE_EMAIL_SERVICE=brevo

# Brevo — server-only (/api/contact), primary on Vercel
BREVO_API_KEY=xkeysib-...
BREVO_FROM_EMAIL=florthiers@gmail.com
BREVO_TO_EMAIL=florthiers@gmail.com

# Resend — optional fallback if BREVO_API_KEY is not set
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Brevo MCP token — ONLY for Cursor MCP in workflow-os, not the contact route.
BREVO_MCP_TOKEN=
VITE_WEB3FORMS_ACCESS_KEY=
VITE_FORMSPREE_FORM_ID=
VITE_SENDGRID_API_KEY=

# Investment page APIs — server-only (/api/private/market/*). Requires site login.
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Julia Life OS API (Vercel serverless — never prefix with VITE_)
JULIA_API_SECRET=generate-a-long-random-string
NOTION_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional persistent usage dashboard (free tier at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
